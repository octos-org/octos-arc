{
  "schema_version": 1,
  "description": "Blob-SHA pin on the upstream decision records and vendored documentation the ARC-Bench competition baseline inherits. arc-runtime-lock.json pins the code; this pins the decisions (#70) and the vendored book/architecture snapshot (#215). Verified by scripts/check-decision-lock.py.",
  "upstream": {
    "repository": "octos-org/octos",
    "commit": "8558a3bff41f43838130808a1fa6cf0299e0bc40",
    "tag": "arc-base-20260910",
    "drift_ref": "main"
  },
  "groups": {
    "protocol-spec": {
      "description": "The OUP protocol specification and wire inventory, plus the client feature-requirement records. scripts/check-ui-protocol-upcr.sh gates changes to these against a UPCR.",
      "patterns": [
        "api/*.md"
      ]
    },
    "upcr": {
      "description": "UI Protocol Change Requests — the numbered record of every protocol decision.",
      "patterns": [
        "docs/OCTOS_UI_PROTOCOL_CHANGE_REQUEST_UPCR_*.md"
      ]
    },
    "adr": {
      "description": "Architecture decision records, both the docs/adr/ directory and the older *-ADR / *-SPEC documents in docs/.",
      "patterns": [
        "docs/adr/*",
        "docs/*-ADR.md",
        "docs/*-SPEC.md"
      ]
    },
    "contracts": {
      "description": "Runtime, release and harness contract documents.",
      "patterns": [
        "docs/*CONTRACT*.md",
        "docs/*CONTRACT*.txt"
      ]
    },
    "task-specs": {
      "description": "Per-task specification records.",
      "patterns": [
        "specs/*"
      ]
    },
    "vendored-book": {
      "description": "The complete octos book, vendored at the pinned base. Participants read this to operate the runtime this repository builds, so it is pinned like any other inherited artifact rather than tracking upstream (#215). Note: '*' spans '/' in fnmatch, so this pattern covers the whole subtree.",
      "patterns": [
        "book/*"
      ]
    },
    "vendored-book-zh": {
      "description": "The Chinese octos book, vendored at the pinned base. This is the primary documentation for this repository's audience.",
      "patterns": [
        "book-zh/*"
      ]
    },
    "vendored-architecture": {
      "description": "The runtime architecture document, vendored at the pinned base.",
      "patterns": [
        "docs/ARCHITECTURE.md"
      ]
    }
  },
